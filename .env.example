# Copy to .env and fill in. .env is gitignored and never leaves this machine.

# Required for live runs. Free tier: https://openweathermap.org/api
# New keys take ~10 minutes to a couple of hours to activate; until then the API
# returns 401 and the pipeline reports it as an AuthError with an actionable message.
OWM_API_KEY=

# Optional. When set, the apology writer calls Claude for the customer message
# instead of the built-in template engine. Falls back to the template on any error.
ANTHROPIC_API_KEY=

# --- Tuning (all optional, defaults shown) ---

# Upper bound on simultaneous in-flight requests. With 4 orders every task
# dispatches immediately; this only starts to bind on larger order books.
MAX_CONCURRENCY=8

# Per-attempt deadline. A hung socket cannot stall the run past this.
REQUEST_TIMEOUT_MS=8000

# Total attempts per city, including the first. Permanent failures (404, 401)
# ignore this and stop after one attempt.
MAX_ATTEMPTS=3

# Exponential backoff with full jitter: min(BASE * 2^n, CAP) * random().
BACKOFF_BASE_MS=250
BACKOFF_CAP_MS=4000

# Weather conditions that mark an order Delayed, matched case-insensitively
# against the API's weather[0].main field. The default is exactly the set the
# assignment specifies.
DELAY_CONDITIONS=Rain,Snow,Extreme

# OpenWeatherMap retired "Extreme" as a main value; it survives as a legacy group
# covering Tornado, Squall and Ash. Set to true to treat those three as Extreme.
EXTREME_ALIASES=false
