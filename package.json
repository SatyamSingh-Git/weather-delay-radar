{
  "name": "weather-delay-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Weather-aware order delay detection with proven-concurrent fetching and a live ops dashboard.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts --mock",
    "server": "tsx src/server.ts",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:server\" \"npm:dev:web\"",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
